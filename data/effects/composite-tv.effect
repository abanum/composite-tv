/*
 * composite-tv.effect - NTSC composite / snow simulation for OBS
 *
 * Ported from the WebGL2 "NTSC Snow Simulator" (https://github.com/abanum/ZAA,
 * MIT licensed). The receiver signal chain is modelled rather than faked:
 *
 *   Encode : source RGB -> YIQ -> band-limit (Y/I/Q) -> 3.58 MHz modulation
 *   Detect : Rician envelope detection of the carrier + band-limited complex
 *            Gaussian IF noise. field_strength=1 -> clean, 0 -> pure Rayleigh snow.
 *   Decode : Y/C separation (bandpass / 2-ln comb / 3-ln comb) + synchronous
 *            chroma demodulation, YIQ -> RGB.
 *   Display: interlaced weave of two temporally offset fields, beam spot, phosphor
 *            persistence, scanlines, screen curvature and vignette.
 *
 * HLSL (Direct3D 11) is the primary target. The unsigned bit-hash used for the
 * noise generator requires SM4+/GLSL 3.30+.
 */

uniform float4x4 ViewProj;

uniform texture2d image;          // primary input of the current pass
uniform texture2d field_prev;     // Display: previous decoded field (interlace)
uniform texture2d display_prev;   // Display: previous final frame (persistence)
uniform texture2d scope_src;      // Display: detected composite, for the debug waveform
uniform texture2d track_tex;      // Decode: per-row sync/burst measurements (Track pass)
uniform texture2d flywheel_tex;   // Display: smoothed horizontal AFC estimate (Flywheel pass)
uniform texture2d flywheel_prev;  // Flywheel: last field's state, for continuity
uniform float killer_auto;        // 1: colour killer decides from the measured burst
uniform float afc_drift;          // free-run frequency error of the line oscillator [smp/line]
uniform float afc_slop;           // 0: healthy AFC, 1: H-HOLD nearly lost

// Debug waveform overlay
uniform float scope_on;
uniform float scope_line;         // field row to trace
uniform float scope_top;          // 1: draw the panel at the top instead

// Signal output (Pack): header-row metadata for the outside decoder
uniform float pack_format;        // 1: 16-bit R+G, 2: 8-bit grayscale
uniform float pack_tap;           // 0: encoder output, 1: detector output
uniform float pack_field;         // field number, 0..3
uniform float pack_aud_count;     // audio samples carried by this field
uniform float pack_aud_present;   // 1: the FM sound carrier is on

uniform float2 field_size;        // (active samples per ln, active lines per field)
uniform float2 output_size;       // (cx, cy) of the rendered output

// Encode
uniform float luma_cutoff;        // Y bandwidth / fs
uniform float cutoff_i;           // I bandwidth / fs
uniform float cutoff_q;           // Q bandwidth / fs
uniform float enc_chroma_gain;    // modulation chroma gain
uniform texture2d audio_tex;      // FM sound carrier, one texel per signal sample
uniform float audio_gain;         // carrier amplitude in video units (0 = off)
uniform float peaking;            // video amplifier peaking (trailing edge ringing)
uniform float burst_phase;        // colour-burst reference phase [rad]
uniform float field_base_phase;   // per-field base subcarrier phase [rad]
uniform float aspect_mode;        // 0: letterbox, 1: horizontal squeeze
uniform float input_aspect;       // source width / height
uniform float screen_aspect;      // CRT screen shape (width / height)

// Detect
uniform int   field_seed;         // per-field RNG seed
uniform float if_cutoff;          // (IF bandwidth / 2) / fs
uniform float field_strength;     // 0 (snow) .. 1 (clean)
uniform float noise_floor;        // residual grain at full field strength
uniform float agc_jitter;         // AGC hunting
uniform float snow_level;         // detection level for the snow limit (agcLevel)

// Decode
uniform float chroma_cutoff;      // post-demod chroma LPF / fs
uniform float chroma_gain;        // decoder chroma gain (0 = colour killed)
uniform float cyc_phase;          // free-running oscillator phase, snow only [rad]
uniform float contrast;
uniform float brightness;
uniform float yc_mode;            // 0: bandpass, 1: 2-ln comb, 2: 3-ln comb

// FIR weight rotors, (cos, sin) of the per-tap angle 2*pi*cutoff. The weights
// are generated by rotation recurrences instead of per-tap sin/cos.
uniform float2 fir_rot_y;         // luma cutoff (encoder Y and decoder luma)
uniform float2 fir_rot_i;
uniform float2 fir_rot_q;
uniform float2 fir_rot_c;         // decoder chroma LPF
uniform float2 fir_rot_if;        // detector IF filter
uniform float noise_norm_inv;     // 1/sqrt(sum of squared IF taps), from the CPU
uniform float det_sigma;          // lerp(1, noise_floor, field_strength)
uniform float det_blend;          // smoothstep(0, 0.35, field_strength)

// Display
uniform float active_lines;       // drawn scan lines per frame
uniform float field_row_step;     // field rows advanced per drawn line
uniform float line_skip;          // 1: blank alternate lines (240p retro look)
uniform float gap_level;          // brightness left in a skipped gap
uniform float interlace_on;
uniform float frame_parity;       // 0 / 1, flips each frame
uniform float persistence;
uniform float spot_v;             // beam spot radius (lines)
uniform float spot_dx;            // horizontal beam spot half-offset [uv]
uniform float scanline;
uniform float curvature;
uniform float vignette;
uniform float overscan;
uniform float2 screen_fit;        // per-axis scale fitting the tube in the canvas
uniform float inv_active_lines;   // 1 / active_lines
uniform float line_visible;       // scan-line visibility ramp (zoom included)

// Inspection zoom: magnify part of the tube so sub-pixel detail such as the
// beam spot and the scan lines can be judged. 1.0 = off.
uniform float preview_zoom;
uniform float zoom_x;             // magnification centre, 0..1
uniform float zoom_y;

// Shadow mask / aperture grille: the physical RGB phosphor structure on the
// tube face. 0 = none, 1 = slot mask, 2 = delta dot mask, 3 = aperture grille
// (Trinitron, which also gets its damper wires).
uniform float mask_type;
uniform float mask_strength;      // modulation depth
uniform float mask_width;         // phosphor stripe half-width (fill factor)
uniform float mask_triads;        // RGB triads across the tube width
uniform float pixels_per_triad;   // output pixels per triad (zoom included)
uniform float wire_width;         // damper wire shadow width, in triad pitches

// Glitches
uniform float ghost_gain;         // multipath ghost amplitude
uniform float ghost_delay;        // ghost delay in samples (negative = leading)
uniform float beat_gain;          // interfering carrier amplitude
uniform float beat_norm;          // interfering carrier frequency / fs
uniform float beat_phase;         // interfering carrier phase [rad]
uniform float v_roll;             // vertical roll offset [lines]
uniform float vblank_lines;       // vertical blanking depth [lines]
uniform float h_jitter;           // per-line horizontal jitter
uniform float flagging;           // top-of-picture horizontal bend
uniform float head_switch;        // VHS head-switching tear at the bottom
// Tape dropout. Applied to the composite signal in the detect pass, so lengths
// are line periods and the rate is per field row; the CPU derives both from the
// measured statistics.
uniform float dropout_prob;       // chance a debris dropout starts on a row
uniform float dropout_min;        // shortest dropout
uniform float dropout_span;       // ln(longest / shortest)
uniform float dropout_mode;       // 0: none, 1: grey level restorer, 2: 1H delay line
uniform float damage_len;         // permanent crease / scratch, length in lines (0 = none)
uniform float damage_line;        // the field row it is cut across

// Degauss (demagnetising coil): a decaying AC field warps the beam and
// briefly ruins purity. All zero = inactive, which is the normal path.
uniform float degauss_wob;        // geometric ripple amount
uniform float degauss_conv;       // R/B misconvergence offset [uv]
uniform float degauss_tint;       // rainbow purity blotches
uniform float degauss_phase;      // oscillation phase [rad]

// Power on/off animation
uniform float warmup;             // 0: dark .. 1: full brightness
uniform float collapse_v;         // 1: normal .. 0: collapsed to a horizontal line
uniform float collapse_h;         // 1: normal .. 0: converged to a centre dot
uniform float flash;              // discharge flash amount

#define PI 3.141592653589793

/* FIR tap radii (compile-time constants; kept as #define for the effect parser) */
#define R_Y 8
#define R_I 14
#define R_Q 26
#define TAP_RADIUS 6
#define LUMA_R 8
#define CHROMA_R 12

/* Composite storage encoding shared by the encoder and everything downstream.
 * The detector output uses it too, because sync sits at -0.4 and an unsigned
 * texture cannot hold that raw. */
#define STORE_BIAS 0.5
#define STORE_SCALE 0.375

/* Full-line raster geometry (fixed by the NTSC standard, so compile-time on
 * both sides - the C file carries the same numbers). One line is 910 samples
 * at 4fsc = 63.556us; a field is 20 VBI rows followed by 243 active rows,
 * approximating the standard's 262.5 (the half line is bookkeeping for the
 * receiver's interlace, not something this raster has to draw).
 *
 * Two invariants the picture depends on - keep them or the decoder breaks:
 *   ACTIVE_OFFSET % 4 == 0 : 0.5*PI*156 = 78*PI = 0 (mod 2*PI), so the
 *       subcarrier phase at active sample na equals the phase at signal
 *       sample na + ACTIVE_OFFSET and the decoder needs no phase shift.
 *       Break it and every hue on screen rotates.
 *   VBI_ROWS % 2 == 0 : linePhaseOf(row) == linePhaseOf(row - VBI_ROWS),
 *       so the per-line phase alternation agrees between the two spaces.
 *       Break it and chroma inverts. */
#define SIG_W 910
#define SIG_H 263
#define VBI_ROWS 20
#define ACTIVE_OFFSET 156         /* front porch 21 + sync 67 + back porch 68 */
#define FRONT_PORCH 21            /* 1.5us */
#define SYNC_W 67                 /* 4.7us */
#define BURST_START 107           /* breezeway after the sync trailing edge */
#define BURST_END 143             /* nine subcarrier cycles */
#define HALF_LINE 455             /* VBI pulses run at twice line rate */
#define EQ_W 33                   /* equalizing pulse, 2.3us */
/* No parentheses around the value: the libobs preprocessor reads any "(" after
 * a define name - whitespace or not - as a macro parameter list. */
#define SYNC_LEVEL -0.4           /* -40 IRE; blanking = 0, peak white = 1 */
#define BURST_AMP 0.2             /* +/-20 IRE */
#define PACK_H 264                /* signal rows plus one header row at the bottom */

/* Receiver tracking (Track / Flywheel passes). The sync separator looks for
 * the pulse's leading edge inside a gate at the head of the line; the
 * flywheel is the horizontal AFC, an exponential average whose time constant
 * is what turns a timing step into the classic bend. Offsets are stored as
 * value / TRACK_SPAN + 0.5, phases as rad / 2pi + 0.5. */
#define SYNC_EDGE 21              /* where the leading edge nominally falls */
#define SYNC_SEARCH 30            /* gate half-width the separator hunts over */
#define TRACK_SPAN 160.0          /* offset storage scale, samples */
#define AFC_GAIN 0.08             /* tracking gain per locked line: tau of ~12 lines */

/* How much of the peaking resonance survives each sample. Settled by eye
 * against real footage: at 0.9 the tail is still worth carrying at the far
 * end of the tap range, so it runs the whole way out. */
#define RING_DECAY 0.9

sampler_state pointClamp {
	Filter    = Point;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

sampler_state linearClamp {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v)
{
	VertData o;
	o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj);
	o.uv  = v.uv;
	return o;
}

// Every FIR here is a windowed sinc: 2*fc * sin(2*pi*fc*k)/(2*pi*fc*k) *
// (0.54 + 0.46*cos(pi*k/(R+1))). Both trig factors advance by a fixed angle
// per tap, so instead of calling sin/cos for every tap the loops keep (cos,
// sin) state vectors, started exactly at k = 0 (1, 0), and advance them with
// this rotation. The cutoff-dependent rotors come in as uniforms; the Hamming
// rotors depend only on the fixed radii and are the literals below.
float2 rotStep(float2 cs, float2 rot)
{
	return float2(cs.x * rot.x - cs.y * rot.y, cs.y * rot.x + cs.x * rot.y);
}

#define HAM9  float2(0.93969262, 0.34202014)   /* pi/9,  R_Y and LUMA_R */
#define HAM15 float2(0.97814760, 0.20791169)   /* pi/15, R_I            */
#define HAM27 float2(0.99323836, 0.11609291)   /* pi/27, R_Q            */
#define HAM13 float2(0.97094182, 0.23931551)   /* pi/13, CHROMA_R       */
#define HAM7  float2(0.90096887, 0.43388374)   /* pi/7,  TAP_RADIUS     */

// Sample index and clamped scan line for a field-space uv.
int2 fieldCoord(float2 uv)
{
	return int2((int)floor(uv.x * field_size.x),
		    clamp((int)floor(uv.y * field_size.y), 0, (int)field_size.y - 1));
}

// The same for the full-line signal raster (Encode and Detect run on it).
int2 sigCoord(float2 uv)
{
	return int2((int)floor(uv.x * (float)SIG_W),
		    clamp((int)floor(uv.y * (float)SIG_H), 0, SIG_H - 1));
}

// Subcarrier reference phase at the head of a scan line. Encode and decode
// must agree exactly, so both go through this.
float linePhaseOf(int ln)
{
	return field_base_phase + ((fmod((float)ln, 2.0) >= 0.5) ? PI : 0.0);
}

// The signal rasters (encoder output, and now the detector output too) are
// stored as amplitude * STORE_SCALE + STORE_BIAS so they fit an unsigned
// texture; these two read them back raw and in signal units. Coordinates are
// signal-space: 910 samples across the full line, VBI rows included.
float compAt(int n, int ln)
{
	int nx = clamp(n, 0, SIG_W - 1);
	int ny = clamp(ln, 0, SIG_H - 1);
	float2 uv = float2(((float)nx + 0.5) / (float)SIG_W, ((float)ny + 0.5) / (float)SIG_H);
	return image.Sample(pointClamp, uv).r;
}

float compositeAt(int n, int ln)
{
	return (compAt(n, ln) - STORE_BIAS) / STORE_SCALE;
}

// Sync structure of the full-line raster, in video units (blanking = 0, sync
// tip = SYNC_LEVEL). Rows 0..8 carry the vertical interval - equalizing
// pulses, the serrated vertical sync, equalizing pulses again, all at twice
// line rate so a receiver keeps horizontal lock through the field change.
// Every other row gets the ordinary horizontal pulse on its front porch.
float syncBaseAt(float ns, int row)
{
	if (row < 9) {
		float ph = fmod(ns, (float)HALF_LINE);
		if (row >= 3 && row < 6) {
			// Serrated vertical sync: held low for the whole half line
			// except the 4.7us serration restoring blanking before each
			// half-line boundary.
			if (ph >= 0.0 && ph < (float)(HALF_LINE - SYNC_W))
				return SYNC_LEVEL;
		} else if (ph >= (float)FRONT_PORCH && ph < (float)(FRONT_PORCH + EQ_W)) {
			// Equalizing pulses: half the ordinary width, at the ordinary
			// leading-edge position within each half line.
			return SYNC_LEVEL;
		}
		return 0.0;
	}
	if (ns >= (float)FRONT_PORCH && ns < (float)(FRONT_PORCH + SYNC_W))
		return SYNC_LEVEL;
	return 0.0;
}

// Colour burst on the back porch: nine subcarrier cycles for the receiver to
// lock its reference to. Chroma here is modulated as I*cos(th) + Q*sin(th)
// with th = w*t + 33 deg (burst_phase folds the 33 in), and the NTSC burst
// sits at w*t + 180 deg = th + 147 deg. That relative angle is what makes an
// outside decoder reproduce the hues; our own decoder never looks at it.
// No burst during the nine vertical-pulse rows, as per the standard.
// Position (ns) and phase (phn) come in separately, because a colour-under
// deck shifts the one without the other - see the time-base block in Encode.
float burstAt(float ns, float phn, int row)
{
	if (row < 9 || ns < (float)BURST_START || ns >= (float)BURST_END)
		return 0.0;
	float th = 0.5 * PI * phn + linePhaseOf(row) + burst_phase;
	return BURST_AMP * sin(th + 2.5656340);
}

// Float-only hash (Dave Hoskins, hash13). Avoids integer/uint ops so the effect
// parses on both the Direct3D and OpenGL back-ends of libobs.
float hash13(float3 p3)
{
	p3 = frac(p3 * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return frac((p3.x + p3.y) * p3.z);
}

// Complex Gaussian white noise (sigma = 1) via Box-Muller, clamped to +/-4.
// The encoder evaluates this once per texel into its spare channels; the
// detector reads it back instead of regenerating it for all of its taps.
float2 noiseIQ(int ln, int n)
{
	int nx = (n < 0) ? n + SIG_W : ((n >= SIG_W) ? n - SIG_W : n);
	float3 p = float3((float)nx, (float)ln, (float)field_seed);
	float u1 = max(hash13(p), 1.0e-7);
	float u2 = hash13(p + float3(37.0, 17.0, 5.0));
	float r  = sqrt(-2.0 * log(u1));
	float a  = 2.0 * PI * u2;
	return clamp(float2(r * cos(a), r * sin(a)), -4.0, 4.0);
}

// ---- line time-base errors --------------------------------------------
// A timing fault is a shift of the whole line - sync pulse included - on the
// time axis, so it lives in the signal, not in the beam. Two populations with
// different chroma physics:
//
//   rxJitterOf : reception jitter. The RF path shifts everything, subcarrier
//       phase included, so the phase reference travels with the shift. The
//       decoder compensates with the same function - that is its stand-in
//       for a burst-locked receiver until a real burst PLL exists.
//   tapeShiftOf : the deck's time-base errors (flagging at the top of the
//       picture, the head-switching tear at the bottom). A colour-under deck
//       re-modulates chroma on playback with a stable local oscillator, so
//       the timing shifts but the subcarrier phase does NOT - which is why
//       real VHS flagging bends the picture without spinning its hue.
//
// Offsets are in samples. Both are zero whenever their sliders are.
float rxJitterOf(int srow)
{
	if (h_jitter <= 0.0)
		return 0.0;
	return h_jitter * (hash13(float3((float)srow, (float)field_seed, 3.0)) - 0.5) * 0.06 * field_size.x;
}

float tapeShiftOf(int srow)
{
	float o = 0.0;
	float t = saturate(((float)(srow - VBI_ROWS) + 0.5) / field_size.y);
	if (flagging != 0.0)
		o += flagging * 0.12 * exp(-t * 18.0) * field_size.x;
	if (head_switch > 0.0 && srow >= VBI_ROWS) {
		float band = head_switch * 0.05;
		float fromBottom = 1.0 - t;
		if (fromBottom < band) {
			float depth = 1.0 - fromBottom / max(band, 1.0e-4);
			o += (hash13(float3((float)srow, (float)field_seed, 9.0)) - 0.5) * 0.25 * depth * field_size.x;
		}
	}
	return o;
}

//============================================================================
// Encode : RGB -> composite
//============================================================================

float3 rgb2yiq(float3 c)
{
	return float3(
		0.299 * c.r + 0.587 * c.g + 0.114 * c.b,
		0.596 * c.r - 0.274 * c.g - 0.322 * c.b,
		0.211 * c.r - 0.523 * c.g + 0.312 * c.b);
}

// Letterbox-aware source sampling. The vertical half of the transform depends
// only on the scan line, so the caller resolves it once and passes the result
// in as rowY / rowOut instead of redoing it for every FIR tap.
float3 sampleRGB(float sx, float rowY, float scale, float rowOut)
{
	float ux = sx;
	if (aspect_mode < 0.5) {
		if (scale <= 1.0)
			ux = (sx - 0.5) / scale + 0.5;
		if (rowOut > 0.5 || ux < 0.0 || ux > 1.0)
			return float3(0.0, 0.0, 0.0);
	}
	return image.Sample(linearClamp, float2(ux, rowY)).rgb;
}

float4 PSEncode(VertData v) : TARGET
{
	int2 sc   = sigCoord(v.uv);
	int  n    = sc.x;
	int  srow = sc.y;

	// Line time-base errors. tpos is where this output sample falls on the
	// deck's ideal line (sync and picture both follow it); phN is the sample
	// index the subcarrier phase follows. They differ exactly by the tape
	// shift, because colour-under playback corrects the chroma phase but
	// cannot correct the timing. The tape shift is ADDED: real flagging can
	// bend either way, and this sign keeps the leftward bend the plugin has
	// always drawn.
	float offJ = rxJitterOf(srow);
	float tpos = (float)n - offJ + tapeShiftOf(srow);
	float phN  = (float)n - offJ;

	// The line skeleton exists everywhere; picture only inside the active
	// window. The invariants at the SIG defines are what let the active
	// content keep using its own coordinates for the subcarrier phase.
	float composite = syncBaseAt(tpos, srow) + burstAt(tpos, phN, srow);
	float y = 0.0;

	if (srow >= VBI_ROWS && tpos >= (float)ACTIVE_OFFSET) {
	int   ln  = srow - VBI_ROWS;
	float sx  = (tpos - (float)ACTIVE_OFFSET + 0.5) / field_size.x;
	float du  = 1.0 / field_size.x;
	float row = ((float)ln + 0.5) / field_size.y;

	// Resolve the vertical half of the letterbox fit once for this scan line.
	float scale = input_aspect / screen_aspect;
	float rowY = row;
	float rowOut = 0.0;
	if (aspect_mode < 0.5) {
		if (scale > 1.0)
			rowY = (row - 0.5) * scale + 0.5;
		if (rowY < 0.0 || rowY > 1.0)
			rowOut = 1.0;
	}

	// The weights are even in k, so the +k and -k samples share one weight
	// and the loop runs outward from the centre tap, where the recurrence
	// states start exactly at angle zero.
	float Ay = 2.0 * PI * luma_cutoff;
	float Ai = 2.0 * PI * cutoff_i;
	float Aq = 2.0 * PI * cutoff_q;

	float3 yiq0 = rgb2yiq(sampleRGB(sx, rowY, scale, rowOut));
	y = yiq0.x * (2.0 * luma_cutoff);
	float ci = yiq0.y * (2.0 * cutoff_i);
	float cq = yiq0.z * (2.0 * cutoff_q);
	float ny = 2.0 * luma_cutoff;
	float ni = 2.0 * cutoff_i;
	float nq = 2.0 * cutoff_q;

	float2 sinY = float2(1.0, 0.0);
	float2 hamY = float2(1.0, 0.0);
	float2 sinI = float2(1.0, 0.0);
	float2 hamI = float2(1.0, 0.0);
	float2 sinQ = float2(1.0, 0.0);
	float2 hamQ = float2(1.0, 0.0);

	/* Peaking accumulator: see the tap loop. */
	float ring = 0.0;
	float ringN = 0.0;
	float decay = 1.0;

	for (int k = 1; k <= R_Q; ++k) {
		float fk = (float)k;
		float3 yp = rgb2yiq(sampleRGB(sx + fk * du, rowY, scale, rowOut));
		float3 ym = rgb2yiq(sampleRGB(sx - fk * du, rowY, scale, rowOut));

		sinQ = rotStep(sinQ, fir_rot_q);
		hamQ = rotStep(hamQ, HAM27);
		float wq = 2.0 * cutoff_q * (sinQ.y / (Aq * fk)) * (0.54 + 0.46 * hamQ.x);
		cq += (yp.z + ym.z) * wq; nq += 2.0 * wq;

		if (k <= R_I) {
			sinI = rotStep(sinI, fir_rot_i);
			hamI = rotStep(hamI, HAM15);
			float wi = 2.0 * cutoff_i * (sinI.y / (Ai * fk)) * (0.54 + 0.46 * hamI.x);
			ci += (yp.y + ym.y) * wi; ni += 2.0 * wi;
		}
		// Stepped every tap so the peaking tail below can run past the luma
		// filter's own radius. Inside R_Y it holds exactly what it did when
		// it was stepped there.
		sinY = rotStep(sinY, fir_rot_y);

		if (k <= R_Y) {
			hamY = rotStep(hamY, HAM9);
			float wy = 2.0 * luma_cutoff * (sinY.y / (Ay * fk)) * (0.54 + 0.46 * hamY.x);
			y += (yp.x + ym.x) * wy; ny += 2.0 * wy;
		}

		// Peaking. A real video amplifier is underdamped, so an edge leaves
		// a decaying oscillation behind it at the filter's own corner
		// frequency - which sinY already carries. Only samples that have
		// already gone by contribute, so the ripple trails the edge instead
		// of running ahead of it: that causality is what separates an
		// analogue chain from a linear-phase filter, whose ringing is
		// symmetrical. Taken against the centre tap so flat picture stays
		// flat and only an edge can excite it, and carried across the whole
		// tap range rather than stopping at the luma filter's own radius.
		if (peaking > 0.0) {
			decay *= RING_DECAY;
			float hk = sinY.y * decay;
			ring += (ym.x - yiq0.x) * hk;
			ringN += abs(hk);
		}
	}
	y  /= max(ny, 1.0e-6);
	if (peaking > 0.0)
		y += peaking * ring / max(ringN, 1.0e-6);
	ci /= max(ni, 1.0e-6);
	cq /= max(nq, 1.0e-6);

	// phN is the signal-space sample corrected for reception jitter, and
	// ACTIVE_OFFSET is a multiple of four subcarrier quarter-cycles, so this
	// equals the active-space phase and runs continuously into the burst
	// written on the porch - shifted or not, burst and chroma always agree.
	float phase = 0.5 * PI * phN + linePhaseOf(ln) + burst_phase;
	composite += y + enc_chroma_gain * (ci * cos(phase) + cq * sin(phase));
	}

	// Interfering carrier (herringbone). Phase runs off the absolute sample
	// position, so it shears line to line and produces the classic diagonal
	// pattern - and rainbow cross-colour when it lands near the subcarrier.
	// An interfering transmitter does not pause for blanking, so this rides
	// the full line.
	if (beat_gain > 0.0) {
		float totalN = (float)srow * (float)SIG_W + (float)n;
		composite += beat_gain * sin(2.0 * PI * beat_norm * totalN + beat_phase);
	}

	// FM sound carrier at 4.5 MHz, synthesized on the CPU (FM has memory -
	// its phase is the integral of the audio) and added like the real
	// intercarrier: over the whole line, blanking included. Everything a
	// receiver makes of it - the fine ripple, the 4.5 MHz dots of a missing
	// trap, the buzz against the picture - falls out downstream.
	if (audio_gain > 0.0)
		composite += audio_gain * audio_tex.Sample(pointClamp, v.uv).r;

	float stored = composite * STORE_SCALE + STORE_BIAS;
	// The detector's complex IF noise rides along in the spare channels,
	// generated once per texel here instead of once per tap there.
	float2 nn = noiseIQ(srow, n) * 0.125 + 0.5;
	return float4(clamp(stored, 0.0, 1.0), y, nn.x, nn.y);
}

//============================================================================
// Detect : Rician envelope detection of encoder-generated IF noise
//============================================================================

// The encoder wrote the complex Gaussian noise into its spare channels; read
// it back, wrapping the column exactly like the generator does.
float2 noiseAt(int n, int ln)
{
	int nx = (n < 0) ? n + SIG_W : ((n >= SIG_W) ? n - SIG_W : n);
	float2 uv = float2(((float)nx + 0.5) / (float)SIG_W, ((float)ln + 0.5) / (float)SIG_H);
	return image.Sample(pointClamp, uv).ba * 8.0 - 4.0;
}

// A dropout is a stretch of tape signal that never reaches the head, so it
// lives on the time axis rather than on the raster: t = row + x, one unit per
// line period. One that starts late in a line simply carries on at the start of
// the next, which is why a long defect climbs the picture as a staircase
// instead of sitting in it as a block. Measured lengths run from about 0.5us -
// below that the tape signal cannot fall away in time - to a millisecond, with
// the count falling off logarithmically as they get longer, so the short ones
// dominate by far.
//
// Rows here are field rows, because that is what the signal is made of: within
// one field the rows are consecutive line periods, which is exactly the axis a
// dropout runs along.
//
// Returns how much of (row, x) is missing. The ends ramp because head contact
// is lost and regained gradually. `age` is how many line periods the defect has
// already run, which is what a delay-line compensator has to recirculate.
float dropoutAt(int row, float x, out float age, out float startLine, out float span)
{
	age = 0.0;
	startLine = 0.0;
	span = 0.0;
	float cover = 0.0;

	// Far enough back to catch a defect that started on an earlier line and is
	// still running: the longest one the CPU hands over is just under four
	// line periods, and it may have started at the very end of its line.
	for (int k = 0; k < 5; ++k) {
		float l0 = (float)(row - k);

		// Two populations. Debris shed by the tape lands somewhere new on
		// every pass, so it is keyed to the field; a crease or a scratch is
		// cut into the surface, comes back at the same place every time, and
		// is placed by hand rather than rolled for.
		for (int s = 0; s < 2; ++s) {
			float len = 0.0;
			float x0 = 0.0;
			if (s == 0) {
				if (hash13(float3(l0, (float)field_seed, 11.0)) < dropout_prob) {
					float u = hash13(float3(l0, (float)field_seed, 17.0));
					len = dropout_min * exp(u * u * u * dropout_span);
					x0 = hash13(float3(l0, (float)field_seed, 13.0));
				}
			} else if (damage_len > 0.0 && abs(l0 - damage_line) < 0.5) {
				len = damage_len;
			}

			if (len > 0.0) {
				float pos = (float)k + x - x0;
				if (pos >= 0.0 && pos < len) {
					// Contact is lost and regained gradually, so the
					// two ends ramp rather than switch.
					float ramp = max(len * 0.15, 0.004);
					float a = saturate(min(pos, len - pos) / ramp);
					if (a > cover) {
						cover = a;
						age = (float)k;
						startLine = l0;
						span = len;
					}
				}
			}
		}
	}

	return cover;
}

float4 PSDetect(VertData v) : TARGET
{
	int2 sc = sigCoord(v.uv);
	int  n  = sc.x;
	int  ln = sc.y; /* signal row: VBI rows first, active from VBI_ROWS on */

	// Band-limit the noise with the IF filter. Same recurrence-generated
	// even weights as the encoder; the normalisation constant only depends
	// on the cutoff, so it comes precomputed from the CPU.
	float Aif = 2.0 * PI * if_cutoff;
	float2 sinF = float2(1.0, 0.0);
	float2 hamF = float2(1.0, 0.0);
	float2 noise = noiseAt(n, ln) * (2.0 * if_cutoff);
	for (int k = 1; k <= TAP_RADIUS; ++k) {
		float fk = (float)k;
		sinF = rotStep(sinF, fir_rot_if);
		hamF = rotStep(hamF, HAM7);
		float wgt = 2.0 * if_cutoff * (sinF.y / (Aif * fk)) * (0.54 + 0.46 * hamF.x);
		noise += (noiseAt(n + k, ln) + noiseAt(n - k, ln)) * wgt;
	}
	noise *= noise_norm_inv;

	float composite = compositeAt(n, ln);

	// Tape dropout, applied to the signal itself rather than to the picture:
	// the deck put this on its output long before anything downstream saw it,
	// so it has to survive detection and decoding like everything else. That
	// is also what makes the colour behave - a stretch of signal with no
	// subcarrier in it decodes as monochrome on its own, with nothing here
	// having to say so.
	if (dropout_prob > 0.0 || damage_len > 0.0) {
		float age, startRow, span;
		float a = dropoutAt(ln, ((float)n + 0.5) / (float)SIG_W, age, startRow, span);
		if (a > 0.0) {
			float lost;
			if (dropout_mode > 1.5) {
				// A 1H delay line, which recirculates its own output:
				// each further line the defect runs comes back weaker.
				// Averaging two samples a half subcarrier cycle apart is
				// how a real one drops the chroma it cannot correct - at
				// 4fsc that is exactly two samples.
				int src = (int)startRow - 1;
				lost = 0.5 * (compositeAt(n - 1, src) + compositeAt(n + 1, src)) * pow(0.8, age);
			} else if (dropout_mode > 0.5) {
				// Grey level restorer: half amplitude, no subcarrier.
				lost = 0.5;
			} else {
				// Uncompensated: the luma FM demodulator has nothing to
				// lock to and rails past peak white. Over a long defect
				// there is nothing for the limiter either, so what comes
				// out sparkles instead of sitting flat.
				float sp = saturate((span - 0.25) * 3.0);
				float nz = hash13(float3((float)n, (float)ln, (float)field_seed));
				lost = 1.1 * lerp(1.0, 0.25 + 1.1 * nz, sp);
			}
			composite = lerp(composite, lost, a);
		}
	}

	// Head switching. At the foot of the field the drum hands the tape over
	// from one head to the other, and for the moment that takes there is no
	// RF to demodulate - so the last lines come through as noise. The tear
	// that goes with it is a timing fault and stays with the beam; this is
	// the part that is in the signal, and it uses the same band shape so the
	// two line up.
	if (head_switch > 0.0 && ln >= VBI_ROWS) {
		float fromBottom = 1.0 - ((float)(ln - VBI_ROWS) + 0.5) / field_size.y;
		float band = head_switch * 0.05;
		if (fromBottom < band) {
			float depth = saturate(1.0 - fromBottom / max(band, 1.0e-4));
			float nz = hash13(float3((float)n, (float)ln, (float)field_seed + 31.0));
			composite = lerp(composite, 0.15 + 0.8 * nz, depth);
		}
	}

	// Multipath ghost: a delayed, attenuated copy of the same carrier. Added
	// before Y/C separation, so the ghost carries chroma and smears colour
	// exactly like a real reflection. Negative delay gives a leading ghost.
	if (ghost_gain > 0.0)
		composite += ghost_gain * compositeAt(n - (int)ghost_delay, ln);

	float A = field_strength * (1.0 + composite);
	float re = A + noise.x * det_sigma;
	float im = noise.y * det_sigma;
	float env = sqrt(re * re + im * im);

	float videoDetected = (env - field_strength) / max(field_strength, 0.15);
	float wobble = 1.0 + agc_jitter * (hash13(float3((float)field_seed, (float)ln, 7.0)) - 0.5);
	float snowDetected = 1.0 - env * (snow_level / 1.2533141) * wobble;
	float detected = lerp(snowDetected, videoDetected, det_blend);

	// Stored, not clamped to video levels: sync sits at -0.4 and has to
	// survive - the decoder and the scope both decode this encoding back.
	return float4(clamp(detected * STORE_SCALE + STORE_BIAS, 0.0, 1.0), 0.0, 0.0, 1.0);
}

//============================================================================
// Track : the receiver reads its own timing off the received signal
//============================================================================

// One texel per signal row. This is the receiver's measuring side: the sync
// separator slices the received line for the pulse's leading edge, and the
// burst gate - keyed off that edge, as in a real set - correlates nine cycles
// against the reference oscillator. Everything downstream (the horizontal
// AFC, the chroma reference, the colour killer) consumes these measurements
// instead of asking the encoder what it did. Weak signal therefore degrades
// the receiver honestly: the separator mistriggers on noise, the burst
// correlation loses amplitude, and nothing here is told the field strength.
//
// Output per row: R = sync timing error, G = burst phase error,
// B = burst amplitude, A = 1 when a real edge was found.
float4 PSTrack(VertData v) : TARGET
{
	int row = clamp((int)floor(v.uv.x * (float)SIG_H), 0, SIG_H - 1);

	// The nine vertical-pulse rows keep their edges at the nominal spot by
	// construction - that is exactly what equalizing pulses are for - so the
	// separator reports nominal instead of being confused by their widths.
	if (row < 9)
		return float4(0.5, 0.5, 0.0, 1.0);

	// Sync separator, matched-filter style: slide a window the width of the
	// pulse across the gate and take the offset where it sums lowest. This
	// is what an integrating separator does, and it is what makes the
	// receiver degrade honestly instead of falling for the first noise
	// spike: averaging over the 67-sample pulse buys a factor of eight
	// against per-sample noise, so lock holds far down into the snow -
	// and when the noise finally wins, the minimum lands somewhere random
	// in the gate and the flywheel starts to swim. The running sum makes
	// the search two adds per candidate instead of a fresh 67-tap sum.
	float acc = 0.0;
	for (int k = 0; k < SYNC_W; ++k)
		acc += compositeAt(SYNC_EDGE - SYNC_SEARCH + k, row);
	float best = acc;
	float syncErr = -(float)SYNC_SEARCH;
	for (int sh = -SYNC_SEARCH + 1; sh <= SYNC_SEARCH; ++sh) {
		acc += compositeAt(SYNC_EDGE + sh + SYNC_W - 1, row) - compositeAt(SYNC_EDGE + sh - 1, row);
		if (acc < best) {
			best = acc;
			syncErr = (float)sh;
		}
	}
	// Lock quality: how much of the chosen window actually sits at sync
	// level. A noise-picked window scatters around blanking and scores low;
	// a real pulse holds its bottom. This is what the flywheel trusts.
	float held = 0.0;
	for (int m = 0; m < SYNC_W; ++m) {
		if (compositeAt(SYNC_EDGE + (int)syncErr + m, row) < -0.25)
			held += 1.0;
	}
	float q = saturate((held / (float)SYNC_W - 0.35) * 2.2);

	// Burst gate, keyed off the measured edge. Correlating against the
	// fixed-grid reference makes the result directly usable as the demod
	// correction: for a burst at sin(theta + d) the two sums come out as
	// C ~ sin(d), S ~ cos(d), so d = atan2(C, S).
	float C = 0.0;
	float S = 0.0;
	// The magnitude of a noise correlation is biased upward - in heavy snow
	// it reads LARGER than a real burst - so a second, burst-free window
	// (the flat bottom of the sync pulse, full cycles of carrier sum to
	// zero over DC) measures the noise floor and the detector reports the
	// margin above it. This is what keeps the colour killer honest.
	float C2 = 0.0;
	float S2 = 0.0;
	for (int k = 0; k < 36; ++k) {
		int n = BURST_START + (int)syncErr + k;
		float s = compositeAt(n, row);
		float th = 0.5 * PI * (float)n + linePhaseOf(row) + burst_phase + 2.5656340;
		C += s * cos(th);
		S += s * sin(th);

		int n2 = SYNC_EDGE + (int)syncErr + 15 + k;
		float s2 = compositeAt(n2, row);
		float th2 = 0.5 * PI * (float)n2 + linePhaseOf(row) + burst_phase + 2.5656340;
		C2 += s2 * cos(th2);
		S2 += s2 * sin(th2);
	}
	float amp = (2.0 / 36.0) * sqrt(C * C + S * S);
	float ref = (2.0 / 36.0) * sqrt(C2 * C2 + S2 * S2);
	float dphi = atan2(C, S);

	return float4(syncErr / TRACK_SPAN + 0.5, dphi / (2.0 * PI) + 0.5, saturate(amp - ref), q);
}

//============================================================================
// Flywheel : the horizontal AFC
//============================================================================

// The line oscillator, run down the field from the top: on every line it is
// pulled toward the measured sync error with a gain weighted by how much the
// separator trusted that line, and for whatever trust is missing it free-runs
// - drifting by its own frequency error, which is what a free oscillator
// does. That one recurrence is the whole character of horizontal lock: a slow
// timing error is followed and vanishes from the screen, a step takes lines
// to catch up with and paints the bend while it does, per-line jitter passes
// through untouched, and as the sync sinks into noise the picture starts to
// swim and finally tears diagonally - all from the same three terms.
// afc_slop is the H-HOLD knob off its sweet spot. The healthy tracker below
// is untouched by it; what the knob raises is the loop's own instability. An
// AFC pushed past its stability margin does not decay to rest - it settles
// into a LIMIT CYCLE, a sustained self-oscillation whose amplitude the
// nonlinearity caps (van der Pol dynamics, the classic model for exactly
// this). That is the serpentine of a set about to lose horizontal hold: it
// never stops, it does not care how clean the signal is, and because the
// oscillator state carries across fields the waves crawl instead of
// re-rolling. At zero slop the cycle's target amplitude is zero and the
// residual damping kills any leftover motion.
float4 PSFlywheel(VertData v) : TARGET
{
	int row = clamp((int)floor(v.uv.x * (float)SIG_H), 0, SIG_H - 1);

	// Continue last field's state: tracker phase (R), and the limit
	// cycle's position (G) and velocity (B).
	float2 last = float2(((float)(SIG_H - 1) + 0.5) / (float)SIG_H, 0.5);
	float4 pv = flywheel_prev.Sample(pointClamp, last);
	float h  = clamp((pv.r - 0.5) * TRACK_SPAN, -80.0, 80.0);
	float ho = clamp((pv.g - 0.5) * TRACK_SPAN, -80.0, 80.0);
	float vo = clamp((pv.b - 0.5) * 32.0, -16.0, 16.0);

	// A dead-still cycle needs a nudge to find out whether it should grow.
	if (afc_slop > 0.0 && abs(ho) + abs(vo) * 10.0 < 0.5)
		vo = 0.1;

	float L = 60.0 * afc_slop * afc_slop + 1.0e-3;
	float mu = 0.2 * afc_slop;

	for (int r = 0; r <= row; ++r) {
		float2 uv = float2(((float)r + 0.5) / (float)SIG_H, 0.5);
		float4 t = image.Sample(pointClamp, uv);
		float e = (t.r - 0.5) * TRACK_SPAN;
		float q = t.a;

		// The healthy flywheel: trust-weighted tracking, free-run drift
		// for whatever trust is missing.
		h += AFC_GAIN * q * (e - h) + (1.0 - q) * afc_drift;

		// The limit cycle: negative damping inside the target amplitude,
		// positive outside, so it neither dies nor blows up.
		float a2 = (ho * ho + (vo / 0.1) * (vo / 0.1)) / (L * L);
		vo += 0.1 * (mu * (1.0 - a2) - 0.15 * (1.0 - afc_slop)) * vo - 0.01 * ho;
		vo = clamp(vo, -16.0, 16.0);
		ho = clamp(ho + vo, -80.0, 80.0);
	}

	return float4(clamp(h / TRACK_SPAN + 0.5, 0.0, 1.0), clamp(ho / TRACK_SPAN + 0.5, 0.0, 1.0),
		      clamp(vo / 32.0 + 0.5, 0.0, 1.0), 1.0);
}

//============================================================================
// Decode : Y/C separation + synchronous chroma demodulation -> RGB
//============================================================================

// The detector hands over the full signal raster in storage encoding; the
// decoder addresses it in active-picture coordinates. Deliberately NOT
// clamped to the active window: taps running off the left edge read the
// burst and the back porch, and the top row's comb partner is VBI blanking -
// exactly what a real receiver's filters see.
float detAt(int na, int ln)
{
	return (compAt(na + ACTIVE_OFFSET, ln + VBI_ROWS) - STORE_BIAS) / STORE_SCALE;
}

// Comb-filtered luma (x) and chroma (y) contributions of one sample column.
// sl keeps C out of the luma, sc keeps Y out of the chroma.
float2 combSample(int nx, int ln)
{
	float c0 = detAt(nx, ln);
	float cm1 = 0.0;
	float cp1 = 0.0;
	if (yc_mode >= 0.5)
		cm1 = detAt(nx, ln - 1);
	if (yc_mode >= 1.5)
		cp1 = detAt(nx, ln + 1);

	float sl, sc;
	if (yc_mode < 0.5) {
		sl = c0;
		sc = c0;
	} else if (yc_mode < 1.5) {
		sl = 0.5 * (c0 + cm1);
		sc = 0.5 * (c0 - cm1);
	} else {
		sl = 0.25 * (cm1 + 2.0 * c0 + cp1);
		sc = c0 - 0.5 * (cm1 + cp1);
	}
	return float2(sl, sc);
}

float4 PSDecode(VertData v) : TARGET
{
	int2 fc = fieldCoord(v.uv);
	int  n  = fc.x;
	int  ln = fc.y;

	// Luma and chroma read the same texels, so one loop feeds both: the wider
	// chroma FIR drives it and the luma FIR takes the inner taps. cyc_phase
	// (free-running oscillator drift, snow only) comes gated from the CPU.
	// The demodulation phase advances by exactly 90 degrees per sample, so
	// after one sincos at the centre tap the two directions are pure sign
	// rotations - no per-tap trig at all.
	// The demod reference comes from the measured burst of THIS line (Track
	// pass): a burst-gated AFPC, settled within the burst as in a real set.
	// With no usable burst the oscillator free-runs and picks up the slow
	// drift instead - the receiver is never told why the burst vanished.
	float2 tuv = float2(((float)(ln + VBI_ROWS) + 0.5) / (float)SIG_H, 0.5);
	float4 trk = track_tex.Sample(pointClamp, tuv);
	float bphi = (trk.g - 0.5) * (2.0 * PI);
	float lock = smoothstep(0.05, 0.12, trk.b);
	float ph0 = 0.5 * PI * (float)n + linePhaseOf(ln) + burst_phase + lock * bphi + (1.0 - lock) * cyc_phase;
	float cp0 = cos(ph0);
	float sp0 = sin(ph0);

	float2 s0 = combSample(n, ln);
	float luma  = s0.x * (2.0 * luma_cutoff);
	float lnorm = 2.0 * luma_cutoff;
	float ci    = s0.y * cp0 * (2.0 * chroma_cutoff);
	float cq    = s0.y * sp0 * (2.0 * chroma_cutoff);
	float cnorm = 2.0 * chroma_cutoff;

	float Al = 2.0 * PI * luma_cutoff;
	float Ac = 2.0 * PI * chroma_cutoff;
	float cP = cp0;   /* phase at n + k */
	float sP = sp0;
	float cM = cp0;   /* phase at n - k */
	float sM = sp0;
	float2 sinL = float2(1.0, 0.0);
	float2 hamL = float2(1.0, 0.0);
	float2 sinC = float2(1.0, 0.0);
	float2 hamC = float2(1.0, 0.0);

	for (int k = 1; k <= CHROMA_R; ++k) {
		float fk = (float)k;
		float t;
		t = cP; cP = -sP; sP = t;   /* +90 deg */
		t = cM; cM = sM; sM = -t;   /* -90 deg */

		float2 sp = combSample(n + k, ln);
		float2 sm = combSample(n - k, ln);

		sinC = rotStep(sinC, fir_rot_c);
		hamC = rotStep(hamC, HAM13);
		float wc = 2.0 * chroma_cutoff * (sinC.y / (Ac * fk)) * (0.54 + 0.46 * hamC.x);
		ci += (sp.y * cP + sm.y * cM) * wc;
		cq += (sp.y * sP + sm.y * sM) * wc;
		cnorm += 2.0 * wc;

		if (k <= LUMA_R) {
			sinL = rotStep(sinL, fir_rot_y);
			hamL = rotStep(hamL, HAM9);
			float wl = 2.0 * luma_cutoff * (sinL.y / (Al * fk)) * (0.54 + 0.46 * hamL.x);
			luma += (sp.x + sm.x) * wl;
			lnorm += 2.0 * wl;
		}
	}
	luma /= max(lnorm, 1.0e-6);
	float inv = 2.0 / max(cnorm, 1.0e-6);
	// The automatic colour killer: no measured burst, no colour. This is why
	// snow on a real set is monochrome, and it needs no wiring to the field
	// strength - the burst simply drowns. The manual modes bypass it.
	float ckill = (killer_auto > 0.5) ? lock : 1.0;
	ci *= inv * chroma_gain * ckill;
	cq *= inv * chroma_gain * ckill;

	float Y = luma * contrast + brightness;
	float3 rgb = float3(
		Y + 0.9563 * ci + 0.6210 * cq,
		Y - 0.2721 * ci - 0.6474 * cq,
		Y - 1.1070 * ci + 1.7046 * cq);

	return float4(clamp(rgb, 0.0, 1.0), 1.0);
}

//============================================================================
// Display : interlaced CRT presentation
//============================================================================

float2 curve(float2 uv, float amount)
{
	float2 c = uv * 2.0 - 1.0;
	float r2 = dot(c, c);
	c *= 1.0 + amount * r2;
	return c * 0.5 + 0.5;
}

// One phosphor stripe on the wrapped 0..3 subpixel axis: a soft window centred
// on the channel's stripe, black in the guard band between stripes. mask_width
// is the stripe half-width, so it sets the phosphor fill vs the black gap.
// halfe is the edge half-width including the pixel footprint: point-sampling a
// stripe finer than the pixel grid beats against it and paints screen-sized
// rainbow bands, so the edge is widened by the footprint (a box-filter
// approximation) and an under-resolved mask converges on a neutral mix
// instead. Widening is symmetric about the half-amplitude point, which keeps
// the stripe's average - and so the picture brightness - unchanged.
float maskStripe(float sub, float centre, float halfe)
{
	float d = abs(sub - centre);
	d = min(d, 3.0 - d);
	float mid = mask_width * 0.74;
	return smoothstep(mid + halfe, mid - halfe, d);
}

// RGB transmission of the tube-face colour structure at a screen position.
// All three patterns share the triad grid: mx counts triads across the width,
// my is the same physical unit down the screen. Each branch is normalised so
// the average brightness stays roughly unchanged.
float3 shadowMask(float2 suv)
{
	float mx = suv.x * mask_triads;
	float sub = frac(mx) * 3.0;
	float my = suv.y * mask_triads / screen_aspect;

	// Thinner phosphors pass less light, so the normalising gain rises as the
	// width falls to keep the average brightness level (dots go by area, so
	// squared). At the default width of 0.62 this is exactly 1.
	float wgain = 0.62 / max(mask_width, 0.05);

	// Pixel footprint on the subpixel axis, for the anti-alias widening.
	float fp = 3.0 / max(pixels_per_triad, 1.0e-3);
	float halfe = mask_width * 0.26 + fp * 0.5;

	float3 w;
	if (mask_type < 1.5) {
		// Slot mask: vertical RGB stripes broken into slots, adjacent
		// columns staggered by half a slot - the in-line CRT look.
		w = float3(maskStripe(sub, 0.5, halfe), maskStripe(sub, 1.5, halfe),
			   maskStripe(sub, 2.5, halfe));
		float stagger = (fmod(floor(mx), 2.0) >= 1.0) ? 0.5 : 0.0;
		float sy = frac(my / 1.5 + stagger);
		float eY = fp / 9.0;   // vertical footprint in slot-cell units
		w *= smoothstep(0.0 - eY, 0.12 + eY, sy) * smoothstep(1.0 + eY, 0.88 - eY, sy);
		w *= 3.1 * wgain;
	} else if (mask_type < 2.5) {
		// Delta dot mask: round phosphor dots on a hex lattice, the RGB
		// assignment rotating so vertical neighbours differ (delta triads).
		float u = mx * 3.0;
		float v = my * 3.0 / 0.866;
		float vrow = floor(v);
		u += (fmod(vrow, 2.0) >= 1.0) ? 0.5 : 0.0;
		float ch = fmod(floor(u) - vrow, 3.0);
		if (ch < 0.0)
			ch += 3.0;
		float2 cell = float2(frac(u) - 0.5, frac(v) - 0.5);
		float r = mask_width * 0.8065;   // dot radius; 0.50 at default width
		float rc = r * 0.78;
		float re = r * 0.22 + fp * 0.5;
		float dotw = smoothstep(rc + re, max(rc - re, 0.0), length(cell));
		w = dotw * float3((ch < 0.5) ? 1.0 : 0.0,
				  (ch >= 0.5 && ch < 1.5) ? 1.0 : 0.0,
				  (ch >= 1.5) ? 1.0 : 0.0);
		w *= 3.4 * wgain * wgain;
	} else {
		// Aperture grille: unbroken vertical stripes (Trinitron).
		w = float3(maskStripe(sub, 0.5, halfe), maskStripe(sub, 1.5, halfe),
			   maskStripe(sub, 2.5, halfe));
		w *= 2.6 * wgain;
	}
	return w;
}

// Horizontal placement of one scan line as the BEAM draws it: the horizontal
// AFC's current estimate, read from the Flywheel pass. The raw timing errors
// are baked into the decoded field, so what scan-out applies is only the
// receiver's own smoothed estimate: a slow error is followed and straightens
// out, a step paints the bend while the flywheel catches up, per-line jitter
// passes through untouched. The sync upset after a long dropout needs no
// special case any more - the separator's mistriggers pollute the estimate
// and the tear falls out of the measurement.
float lineShift(int li)
{
	float row = floor((float)li * field_row_step) + (float)VBI_ROWS;
	float2 uv = float2((row + 0.5) / (float)SIG_H, 0.5);
	float4 fw = flywheel_tex.Sample(pointClamp, uv);
	/* tracker estimate plus the H-HOLD limit cycle */
	return ((fw.r - 0.5) + (fw.g - 0.5)) * TRACK_SPAN / field_size.x;
}

// Sample a scan ln, choosing the current or previous field for the weave.
float3 sampleLine(int lineIndex, float x)
{
	bool useCur = (interlace_on < 0.5) ||
		      (abs(fmod((float)lineIndex, 2.0) - frame_parity) < 0.5);
	// field_row_step maps drawn lines onto field rows: 0.5 for a 486-line frame
	// (two drawn lines share a row), 1.0 for a 243-line 240p frame.
	float row = (floor((float)lineIndex * field_row_step) + 0.5) / field_size.y;
	float dx = spot_dx;
	x += lineShift(lineIndex);

	// A displaced line runs off the end of its active video, and what lies
	// beyond that is the horizontal blanking interval - black. Without this the
	// clamped sampler would smear the edge column instead, which is what made
	// flagging look like a stretched copy of the picture rather than a bend
	// into blanking.
	if (x < 0.0 || x > 1.0)
		return float3(0.0, 0.0, 0.0);

	float3 outCol;
	if (useCur) {
		float3 ca = image.Sample(linearClamp, float2(x - dx, row)).rgb;
		float3 cb = image.Sample(linearClamp, float2(x + dx, row)).rgb;
		outCol = (ca + cb) * 0.5;
	} else {
		float3 pa = field_prev.Sample(linearClamp, float2(x - dx, row)).rgb;
		float3 pb = field_prev.Sample(linearClamp, float2(x + dx, row)).rgb;
		outCol = (pa + pb) * 0.5;
	}

	// Degauss misconvergence: the residual field pulls the red and blue beams
	// apart, and worse away from the centre - just like a real purity error.
	if (degauss_conv > 0.0) {
		float2 c = float2(x - 0.5, (float)lineIndex * inv_active_lines - 0.5);
		float off = degauss_conv * (0.3 + length(c));
		float3 l = image.Sample(linearClamp, float2(x - off, row)).rgb;
		float3 r = image.Sample(linearClamp, float2(x + off, row)).rgb;
		outCol = float3(r.r, outCol.g, l.b);
	}

	return outCol;
}

float4 PSDisplay(VertData v) : TARGET
{
	// Inspection zoom: look at a smaller piece of the output, blown up. Applied
	// before everything else so it magnifies the finished tube, magnifying
	// glass style. The persistence tap below deliberately stays in unzoomed
	// screen space - the buffer already holds a zoomed frame.
	float2 zuv = v.uv;
	if (preview_zoom > 1.0) {
		float2 c = float2(zoom_x, zoom_y);
		zuv = (v.uv - c) / preview_zoom + c;
	}

	// Fit the CRT screen (aspect = screen_aspect) inside the output canvas,
	// adding black bars when the two aspect ratios differ. suv is the screen
	// coordinate; anything outside [0,1] falls in the black border. The
	// per-axis scales come precomputed from the CPU.
	float2 suv = (zuv - 0.5) * screen_fit + 0.5;

	// Degauss: the decaying AC field deflects the beam, so the whole raster
	// ripples and breathes for about a second.
	if (degauss_wob > 0.0) {
		suv.x += degauss_wob * 0.020 * sin(suv.y * 18.0 - degauss_phase * 2.0);
		suv.y += degauss_wob * 0.004 * sin(suv.x * 11.0 + degauss_phase * 1.7);
		suv = (suv - 0.5) * (1.0 + degauss_wob * 0.010) + 0.5;
	}

	float2 uv = curve(suv, curvature);
	float2 lo = step(float2(0.0, 0.0), uv);
	float2 hi = step(uv, float2(1.0, 1.0));
	float inScreen = lo.x * lo.y * hi.x * hi.y;

	uv = (uv - 0.5) * (1.0 - overscan * 2.0) + 0.5;

	// Power-off collapse: shrink the picture into a horizontal line, then a
	// centre dot, by magnifying the reference around the centre.
	float cV = max(collapse_v, 0.0025);
	float cH = max(collapse_h, 0.0025);
	uv.y = (uv.y - 0.5) / cV + 0.5;
	uv.x = (uv.x - 0.5) / cH + 0.5;
	float bandMask = step(0.0, uv.y) * step(uv.y, 1.0) * step(0.0, uv.x) * step(uv.x, 1.0);

	// Vertical roll (V-hold failure). One frame period is the active picture
	// plus the vertical blanking interval, so the cycle the beam repeats is
	// active_lines + vblank_lines. Blanking sits between successive pictures
	// rather than on top of one - with the hold locked it stays off screen
	// entirely, and only a roll drags it through the visible raster.
	// Wrap first and apply the half-line sample offset after: subtracting it
	// first pushes the topmost half line past the wrap, which used to leave a
	// sliver of the bottom line showing above the bar.
	float cycle = active_lines + vblank_lines;
	float linePos = fmod(uv.y * active_lines + v_roll + cycle * 8.0, cycle);
	float inBar = (linePos >= active_lines) ? 1.0 : 0.0;
	float lineF = linePos - 0.5;

	int base = (int)floor(lineF);
	int maxLine = (int)active_lines;

	float3 col = float3(0.0, 0.0, 0.0);
	float wsum = 0.0;
	float sigma = max(spot_v, 0.15);
	for (int d = -1; d <= 2; ++d) {
		int li = base + d;
		if (li >= 0 && li < maxLine) {
			float dist = (float)li - lineF;
			float wgt = exp(-0.5 * (dist * dist) / (sigma * sigma));
			float3 c = sampleLine(li, uv.x);

			col += c * wgt;
			wsum += wgt;
		}
	}
	col /= max(wsum, 1.0e-5);

	// Scan-line structure can only be drawn when a line spans enough output
	// pixels; below that it would only alias, so the soft ramp and the hard
	// line skip fade out together.
	float lineVisible = line_visible;
	float phase = frac(lineF);
	col *= 1.0 - scanline * lineVisible * (0.5 - 0.5 * cos(2.0 * PI * phase));

	// Line skip: the 240p look, where the beam leaves an unlit gap between the
	// lines. Phase 0 is the beam centre and 0.5 the gap, so blank the middle
	// half of each cell.
	if (line_skip > 0.5) {
		float inGap = (abs(phase - 0.5) < 0.25) ? 1.0 : 0.0;
		col *= lerp(1.0, gap_level, inGap * lineVisible);
	}

	// Blanking bar riding the roll seam: dark, with a little residual noise.
	if (inBar > 0.5) {
		float g = hash13(float3(floor(lineF), floor(uv.x * field_size.x), (float)field_seed));
		col = float3(0.03, 0.03, 0.03) + g * 0.06;
	}

	// Shadow mask / aperture grille: the last physical layer before the glass,
	// so it modulates everything drawn above. Like the scan lines it fades out
	// when a triad spans too few output pixels to draw without aliasing - the
	// inspection zoom raises pixels_per_triad, so magnifying reveals it.
	if (mask_type > 0.5) {
		float mstr = mask_strength * smoothstep(3.0, 4.5, pixels_per_triad);
		if (mstr > 0.0)
			col *= lerp(float3(1.0, 1.0, 1.0), shadowMask(suv), mstr);

		// Trinitron damper wires: the two tungsten wires that still the
		// grille cast faint horizontal shadows at roughly 1/3 and 2/3
		// height. They are physical objects, so their look is independent
		// of the mask's artistic strength: fixed shadow depth, width set by
		// its own control (in triad pitches), and no resolution fade -
		// they are famously visible on real Trinitrons at any size.
		if (mask_type > 2.5) {
			// Floor of one output pixel so the shadow cannot alias away.
			// A wire thinner than that only covers part of the pixel, so
			// the shadow lightens in step - down to 5% at hairline
			// widths, where the wire should barely register.
			float phys = wire_width * screen_aspect / mask_triads;
			float floorw = 1.0 / (output_size.y * preview_zoom);
			float t = max(phys, floorw);
			float cover = 0.05 + 0.95 * saturate(phys / floorw);
			float sh = max(smoothstep(t, t * 0.35, abs(suv.y - 0.3333)),
				       smoothstep(t, t * 0.35, abs(suv.y - 0.6667)));
			col *= 1.0 - 0.45 * cover * sh;
		}
	}

	// col is non-negative, so with no persistence the max() cannot change it.
	if (persistence > 0.0) {
		float3 prev = display_prev.Sample(linearClamp, v.uv).rgb;
		col = max(col, prev * persistence);
	}

	float2 vg = suv * 2.0 - 1.0;
	float vig = 1.0 - vignette * dot(vg, vg) * 0.55;
	col *= clamp(vig, 0.0, 1.0);

	// Degauss purity error: slow rainbow blotches, strongest towards the edges.
	if (degauss_tint > 0.0) {
		float2 q = suv * 3.0;
		float a = sin(q.x * 2.1 + degauss_phase) + sin(q.y * 1.7 - degauss_phase * 1.3) +
			  sin((q.x + q.y) * 1.3 + degauss_phase * 0.7);
		float3 tint = 0.5 + 0.5 * cos(2.0 * PI *(a * 0.15 + float3(0.0, 0.33, 0.67)));
		float edge = 0.35 + dot(vg, vg) * 0.65;
		col = lerp(col, col * tint * 1.6, saturate(degauss_tint * edge));
	}

	// Collapse band + discharge flash.
	col *= bandMask;
	col += float3(flash, flash, flash) * bandMask;

	// Warm-up: dark at first, brightening from the centre outward.
	float centerGlow = 1.0 - dot(vg, vg) * 0.6;
	float warm = clamp(warmup * 1.4 - 0.4, 0.0, 1.0) * lerp(0.4, 1.0, clamp(centerGlow, 0.0, 1.0));
	col *= clamp(warm + warmup * 0.2, 0.0, 1.0);

	float3 outCol = col * inScreen;

	// Debug waveform. What the detector hands the decoder is the composite
	// video itself, so tracing one field row of it draws what a scope on the
	// video detector would draw - degradation and all. Laid over the finished
	// frame rather than into it, so the tube's own geometry, blanking and
	// power state cannot hide it.
	if (scope_on > 0.5) {
		// Which line the trace comes from, marked on the picture itself so
		// the two can be read together. scope_line arrives in signal rows.
		if (floor((float)base * field_row_step) + (float)VBI_ROWS == floor(scope_line))
			outCol = lerp(outCol, float3(1.0, 0.15, 0.15), 0.30);

		// The panel sits away from the line it is tracing, so the marker and
		// the picture around it stay visible.
		float y0 = (scope_top > 0.5) ? 0.02 : 0.62;
		float y1 = y0 + 0.36;
		if (v.uv.y > y0 && v.uv.y < y1) {
			// The trace is drawn between this column's sample and the
			// next one's, so a steep edge joins up instead of leaving
			// the line in pieces. The x axis is the whole 910-sample
			// line: porch, sync and burst included.
			float row = (floor(scope_line) + 0.5) / (float)SIG_H;
			float dx = 1.0 / max(output_size.x, 1.0);
			float s0 = (scope_src.Sample(pointClamp, float2(v.uv.x, row)).r - STORE_BIAS) / STORE_SCALE;
			float s1 = (scope_src.Sample(pointClamp, float2(v.uv.x + dx, row)).r - STORE_BIAS) / STORE_SCALE;

			// Video runs 0 (black) to 1 (white) with sync down at -0.4;
			// the margin leaves the graticule lines clear of the edges.
			float span = 1.6;
			float val = 1.15 - (v.uv.y - y0) / (y1 - y0) * span;
			float w = 1.5 * span / ((y1 - y0) * max(output_size.y, 1.0));

			outCol = lerp(outCol, float3(0.0, 0.02, 0.03), 0.82);
			if (abs(val) < w || abs(val - 1.0) < w || abs(val - SYNC_LEVEL) < w)
				outCol = lerp(outCol, float3(0.45, 0.45, 0.45), 0.85);
			if (val > min(s0, s1) - w && val < max(s0, s1) + w)
				outCol = float3(0.25, 1.0, 0.35);

			// Receiver-tracking traces, field rows mapped across the panel:
			// amber = the AFC estimate the beam applies (fraction of the
			// panel height = TRACK_SPAN samples full scale), cyan = the
			// separator's per-line trust. What the tube does with timing
			// is exactly the amber line.
			float2 fuv = float2(v.uv.x, 0.5);
			float4 fw2 = flywheel_tex.Sample(pointClamp, fuv);
			float4 tk2 = track_tex.Sample(pointClamp, fuv);
			float hshift = (fw2.r - 0.5) + (fw2.g - 0.5); /* -1..1 */
			if (abs(val - (0.35 + hshift)) < w * 1.2)
				outCol = float3(1.0, 0.72, 0.2);
			if (abs(val - (-0.2 + tk2.a * 0.25)) < w)
				outCol = lerp(outCol, float3(0.3, 0.8, 0.95), 0.8);
		}
	}

	return float4(outCol, 1.0);
}

//============================================================================
// Pack : signal output for an outside decoder
//============================================================================

// Repacks a signal raster (encoder or detector output, chosen on the CPU by
// what gets bound as image) into a byte-exact frame for export: 263 signal
// rows in the storage encoding, plus one header row of metadata at the
// bottom. 16-bit mode splits round(stored * 65535) into R = high byte and
// G = low byte; B and A are reserved. 8-bit mode puts the high byte on all
// three channels instead, which reads as an ordinary grayscale picture of
// the signal - sync columns, burst, subcarrier stripes - for eyeballing.
float4 PSPack(VertData v) : TARGET
{
	int px = (int)floor(v.uv.x * (float)SIG_W);
	int py = (int)floor(v.uv.y * (float)PACK_H);

	float v16;
	if (py < SIG_H) {
		// Signal rows pass the storage encoding through untouched; the
		// receiver undoes it with composite = (v/65535 - 0.5) / 0.375.
		float2 uv = float2(((float)px + 0.5) / (float)SIG_W, ((float)py + 0.5) / (float)SIG_H);
		v16 = image.Sample(pointClamp, uv).r;
	} else {
		// Header row, 16-bit values whatever the picture format:
		// magic, version, format, tap, field number, audio sample count,
		// audio present. The rest is zero.
		float hv = 0.0;
		if (px == 0)
			hv = 17236.0; /* 0x4354, "CT" */
		else if (px == 1)
			hv = 1.0;     /* header version */
		else if (px == 2)
			hv = pack_format;
		else if (px == 3)
			hv = pack_tap;
		else if (px == 4)
			hv = pack_field;
		else if (px == 5)
			hv = pack_aud_count;
		else if (px == 6)
			hv = pack_aud_present;
		v16 = hv / 65535.0;
	}

	float q = floor(saturate(v16) * 65535.0 + 0.5);
	float hi = floor(q / 256.0);
	float lo = q - hi * 256.0;
	if (pack_format > 1.5)
		return float4(hi / 255.0, hi / 255.0, hi / 255.0, 1.0);
	return float4(hi / 255.0, lo / 255.0, 0.0, 1.0);
}

// The final blit to the filter output uses libobs' own default effect, so
// there is no passthrough technique here.

technique Encode
{
	pass
	{
		vertex_shader = VSDefault(v);
		pixel_shader  = PSEncode(v);
	}
}

technique Detect
{
	pass
	{
		vertex_shader = VSDefault(v);
		pixel_shader  = PSDetect(v);
	}
}

technique Decode
{
	pass
	{
		vertex_shader = VSDefault(v);
		pixel_shader  = PSDecode(v);
	}
}

technique Display
{
	pass
	{
		vertex_shader = VSDefault(v);
		pixel_shader  = PSDisplay(v);
	}
}

technique Pack
{
	pass
	{
		vertex_shader = VSDefault(v);
		pixel_shader  = PSPack(v);
	}
}

technique Track
{
	pass
	{
		vertex_shader = VSDefault(v);
		pixel_shader  = PSTrack(v);
	}
}

technique Flywheel
{
	pass
	{
		vertex_shader = VSDefault(v);
		pixel_shader  = PSFlywheel(v);
	}
}
